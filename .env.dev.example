# Copy to .env.dev and fill in. Used by deploy.ps1/.sh for the scopeseal-DEV stack on 192.168.1.8.
# This file is BOTH the compose interpolation source (${DB_PASSWORD}, …) AND the api/worker
# container env_file (via ENV_FILE exported by the deploy script).

# --- Runtime ---
ASPNETCORE_ENVIRONMENT=Development

# --- Shared dev Postgres (arx-dev-db network; service name postgres) ---
DB_HOST=postgres
DB_NAME=scopeseal
DB_USER=scopeseal_app
DB_PASSWORD=change-me-after-provision

# --- Auth (generate a unique 64+ char secret per environment) ---
JWT_SECRET=change-me-generate-a-64-char-minimum-secret-for-dev

# --- Blob storage data dir on deploy host (bind-mount for Azurite) ---
AZURITE_DATA=/docker-data/scopeseal/azurite

# --- ArxMail Gateway (org email — never SendGrid/Mailgun) ---
# Provision site keys on the gateway host first (see docs/deployment/ubuntu.md).
ARXMAIL_PROVIDER=ArxMail
ARXMAIL_SUBMIT_URL=https://mail.architonixlabs.com/v1/submit
ARXMAIL_SECRET_KEY=
EMAIL_FROM=noreply@scopeseal.app

# --- Optional: Razorpay test keys (Loop 10) ---
# ScopeSeal__Billing__Razorpay__KeyId=
# ScopeSeal__Billing__Razorpay__KeySecret=
# ScopeSeal__Billing__Razorpay__WebhookSecret=
