# Copy to .env.dev and adjust as needed. Used by deploy.ps1/.sh for scopeseal-DEV on 192.168.1.8.
# This file is BOTH the compose interpolation source (${DB_PASSWORD}, …) AND the api/worker
# container env_file (via ENV_FILE exported by the deploy script).
#
# Defaults below are dev-friendly starting points. Override for production-like staging.

# --- Runtime ---
ASPNETCORE_ENVIRONMENT=Development

# --- Shared dev Postgres (arx-dev-db network; service name postgres) ---
# Provision: scripts/provision.sh postgres scopeseal scopeseal_app 'scopeseal_dev_2026'
# Connection string equivalent:
#   Host=postgres;Port=5432;Database=scopeseal;Username=scopeseal_app;Password=scopeseal_dev_2026
DB_HOST=postgres
DB_NAME=scopeseal
DB_USER=scopeseal_app
DB_PASSWORD=scopeseal_dev_2026

# --- Auth (minimum 32 characters; use a unique secret per environment) ---
JWT_SECRET=scopeseal-dev-jwt-signing-key-minimum-32-characters-long

# --- Blob storage data dir on deploy host (bind-mount for Azurite) ---
AZURITE_DATA=/docker-data/scopeseal/azurite

# --- ArxMail Gateway (org email — never SendGrid/Mailgun) ---
# Replace ARXMAIL_SECRET_KEY after gateway provision (see deploy/MANUAL-STEPS.md).
ARXMAIL_PROVIDER=ArxMail
ARXMAIL_SUBMIT_URL=https://mail.architonixlabs.com/v1/submit
ARXMAIL_SECRET_KEY=arx_sk_dev_placeholder_replace_after_provision
EMAIL_FROM=noreply@scopeseal.app

# --- Razorpay test keys (Loop 10 — replace with dashboard keys when testing billing) ---
ScopeSeal__Billing__Mode=Disabled
ScopeSeal__Billing__TestModeOnly=true
ScopeSeal__Billing__Razorpay__KeyId=rzp_test_scopeseal_dev
ScopeSeal__Billing__Razorpay__KeySecret=scopeseal_razorpay_test_secret
ScopeSeal__Billing__Razorpay__WebhookSecret=scopeseal_razorpay_test_webhook_secret
