# ScopeSeal environment variables (example)
# Copy to .env.local for development — never commit real secrets.

# Application
ASPNETCORE_ENVIRONMENT=Development
ScopeSeal__ProductName=ScopeSeal
ScopeSeal__DefaultTimeZone=Asia/Kolkata
ScopeSeal__DefaultCurrency=INR

# Database (local isolated Postgres via docker-compose.local.yml)
ConnectionStrings__Default=Host=localhost;Port=5432;Database=scopeseal;Username=scopeseal;Password=scopeseal_dev

# Shared dev DB on deploy host (192.168.1.8) — use in .env.dev instead:
# DB_HOST=postgres
# DB_NAME=scopeseal
# DB_USER=scopeseal_app
# DB_PASSWORD=scopeseal_dev_2026
# Connection string equivalent:
#   Host=postgres;Port=5432;Database=scopeseal;Username=scopeseal_app;Password=scopeseal_dev_2026

# Authentication (use a unique secret per environment; override for prod)
ScopeSeal__Auth__JwtSecret=scopeseal-local-jwt-signing-key-minimum-32-characters
ScopeSeal__Auth__JwtIssuer=scopeseal-dev
ScopeSeal__Auth__JwtAudience=scopeseal-api
ScopeSeal__Auth__CookieExpirationHours=8
ScopeSeal__Auth__RequireEmailVerification=false

# Blob storage (local dev may use Azurite)
ScopeSeal__Storage__Provider=Azurite
ScopeSeal__Storage__ConnectionString=UseDevelopmentStorage=true

# AI (default ManualOnly until Loop 9)
ScopeSeal__Ai__Mode=ManualOnly

# Razorpay (Loop 10 — test keys only in non-production; replace with dashboard keys when testing)
ScopeSeal__Billing__Mode=Disabled
ScopeSeal__Billing__TestModeOnly=true
ScopeSeal__Billing__Razorpay__KeyId=rzp_test_scopeseal_dev
ScopeSeal__Billing__Razorpay__KeySecret=scopeseal_razorpay_test_secret
ScopeSeal__Billing__Razorpay__WebhookSecret=scopeseal_razorpay_test_webhook_secret

# Email — org ArxMail Gateway (never SendGrid/Mailgun/SMTP-of-a-provider)
# Local dev: Provider=Development logs to console. Deploy: Provider=ArxMail + secret key.
ScopeSeal__Notifications__Email__Provider=Development
ScopeSeal__Notifications__Email__FromAddress=noreply@scopeseal.app
ScopeSeal__Notifications__Email__ArxMail__SubmitUrl=https://mail.architonixlabs.com/v1/submit
# ScopeSeal__Notifications__Email__ArxMail__SecretKey=arx_sk_…  (server env only — set in .env.dev / .env.prod)

# Frontend (Angular environment)
# NG_APP_API_BASE_URL=http://localhost:5021/api/v1
