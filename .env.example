# ScopeSeal environment variables (example)
# Copy to .env.local for development — never commit real secrets.

# Application
ASPNETCORE_ENVIRONMENT=Development
ScopeSeal__ProductName=ScopeSeal
ScopeSeal__DefaultTimeZone=Asia/Kolkata
ScopeSeal__DefaultCurrency=INR

# Database
ConnectionStrings__Default=Host=localhost;Port=5432;Database=scopeseal;Username=scopeseal;Password=CHANGE_ME

# Authentication (generate per environment)
ScopeSeal__Auth__JwtSecret=CHANGE_ME_MIN_32_CHARS
ScopeSeal__Auth__JwtIssuer=scopeseal-dev
ScopeSeal__Auth__JwtAudience=scopeseal-api

# Blob storage (local dev may use Azurite)
ScopeSeal__Storage__Provider=Azurite
ScopeSeal__Storage__ConnectionString=UseDevelopmentStorage=true

# AI (default ManualOnly until Loop 9)
ScopeSeal__Ai__Mode=ManualOnly

# Razorpay (Loop 10 — test keys only in non-production)
ScopeSeal__Billing__Razorpay__KeyId=
ScopeSeal__Billing__Razorpay__KeySecret=
ScopeSeal__Billing__Razorpay__WebhookSecret=

# Email (TBD)
ScopeSeal__Notifications__Email__Provider=Development
ScopeSeal__Notifications__Email__FromAddress=noreply@example.com

# Frontend (Angular environment)
# NG_APP_API_BASE_URL=http://localhost:5000/api/v1
