# Copy to .env.prod and fill in. Used by deploy.ps1/.sh for the scopeseal-PROD stack.
# Defaults below are placeholders — override ALL secrets before production deploy.
# Never reuse dev values.

ASPNETCORE_ENVIRONMENT=Production

# Prod DB: provision a dedicated role/database on the appropriate Postgres server
# (shared arx-dev-db is dev-only per org policy; prod/on-prem uses its own server).
DB_HOST=postgres
DB_NAME=scopeseal
DB_USER=scopeseal_app
DB_PASSWORD=scopeseal_prod_2026

JWT_SECRET=scopeseal-prod-jwt-signing-key-minimum-32-characters-long

AZURITE_DATA=/docker-data/scopeseal/azurite

ARXMAIL_PROVIDER=ArxMail
ARXMAIL_SUBMIT_URL=https://mail.architonixlabs.com/v1/submit
ARXMAIL_SECRET_KEY=arx_sk_prod_placeholder_replace_after_provision
EMAIL_FROM=noreply@scopeseal.app

# Razorpay live keys — only after CA/tax review; keep Disabled until authorised.
ScopeSeal__Billing__Mode=Disabled
ScopeSeal__Billing__TestModeOnly=false
ScopeSeal__Billing__Razorpay__KeyId=rzp_live_scopeseal_prod
ScopeSeal__Billing__Razorpay__KeySecret=scopeseal_razorpay_live_secret
ScopeSeal__Billing__Razorpay__WebhookSecret=scopeseal_razorpay_live_webhook_secret
