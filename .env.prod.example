# Copy to .env.prod and fill in. Used by deploy.ps1/.sh for the scopeseal-PROD stack.
# Use STRONG, unique secrets — never reuse dev values.

ASPNETCORE_ENVIRONMENT=Production

# Prod DB: provision a dedicated role/database on the appropriate Postgres server
# (shared arx-dev-db is dev-only per org policy; prod/on-prem uses its own server).
DB_HOST=postgres
DB_NAME=scopeseal
DB_USER=scopeseal_app
DB_PASSWORD=change-me-strong-prod

JWT_SECRET=change-me-generate-a-strong-unique-secret

AZURITE_DATA=/docker-data/scopeseal/azurite

ARXMAIL_PROVIDER=ArxMail
ARXMAIL_SUBMIT_URL=https://mail.architonixlabs.com/v1/submit
ARXMAIL_SECRET_KEY=
EMAIL_FROM=noreply@scopeseal.app
