# ScopeSeal root gitignore

# Environment and secrets
.env
.env.local
.env.*.local
*.pfx
*.p12
*.pem
*.key

# .NET
**/bin/
**/obj/
**/.vs/
*.user
*.suo
TestResults/
*.DotSettings.user

# Node / Angular
node_modules/
dist/
.angular/
coverage/
*.log
npm-debug.log*

# IDE
.idea/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store

# Capacitor native projects (track shells; ignore build outputs)
src/clients/android/.gradle/
src/clients/android/app/build/
src/clients/android/build/
src/clients/android/local.properties
src/clients/android/.idea/
src/clients/ios/App/Pods/
src/clients/ios/App/build/
src/clients/ios/App/DerivedData/
src/clients/ios/DerivedData/

# Docker volumes
**/pgdata/

# Playwright
playwright-report/
test-results/
