FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build:product && npm run build:admin && npm run build:marketing

FROM node:22-alpine AS marketing
WORKDIR /app
COPY --from=build /app/dist/marketing-site ./dist/marketing-site
COPY --from=build /app/package*.json ./
RUN npm ci --omit=dev
ENV NODE_ENV=production
ENV PORT=4000
EXPOSE 4000
CMD ["node", "dist/marketing-site/server/server.mjs"]
