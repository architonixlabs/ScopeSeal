<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- NU1902/NU1903: resolved for Microsoft.OpenApi 2.7.5+; suppressions retained for transitive advisories during monitoring -->
    <NoWarn>$(NoWarn);NU1902;NU1903;CA1716;CA1305;CA1848;CA1873;CA1707;CA1861</NoWarn>
  </PropertyGroup>
</Project>
