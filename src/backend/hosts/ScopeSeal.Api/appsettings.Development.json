{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=scopeseal;Username=scopeseal;Password=scopeseal_dev"
  },
  "ScopeSeal": {
    "ProductName": "ScopeSeal",
    "DefaultTimeZone": "Asia/Kolkata",
    "DefaultCurrency": "INR",
    "Auth": {
      "JwtSecret": "local-development-secret-minimum-32-characters",
      "JwtIssuer": "scopeseal-dev",
      "JwtAudience": "scopeseal-api",
      "CookieExpirationHours": 8,
      "RequireEmailVerification": false
    },
    "Storage": {
      "Provider": "Azurite",
      "ConnectionString": "UseDevelopmentStorage=true"
    },
    "Ai": {
      "Mode": "ManualOnly"
    }
  },
  "AllowedHosts": "*"
}
