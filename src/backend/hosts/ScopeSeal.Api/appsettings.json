{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "ScopeSeal": {
    "ProductName": "ScopeSeal",
    "DefaultTimeZone": "Asia/Kolkata",
    "DefaultCurrency": "INR",
    "Auth": {
      "JwtSecret": "",
      "JwtIssuer": "scopeseal",
      "JwtAudience": "scopeseal-api",
      "CookieExpirationHours": 8,
      "RequireEmailVerification": false
    },
    "Storage": {
      "Provider": "Azurite"
    },
    "Ai": {
      "Mode": "ManualOnly"
    }
  },
  "AllowedHosts": "*"
}
