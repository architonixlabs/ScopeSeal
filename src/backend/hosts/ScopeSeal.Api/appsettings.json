{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "ScopeSeal": {
    "ProductName": "ScopeSeal",
    "DefaultTimeZone": "Asia/Kolkata",
    "DefaultCurrency": "INR",
    "Auth": {
      "JwtSecret": "",
      "JwtIssuer": "scopeseal",
      "JwtAudience": "scopeseal-api",
      "CookieExpirationHours": 8,
      "RequireEmailVerification": false
    },
    "Storage": {
      "Provider": "Azurite"
    },
    "Ai": {
      "Mode": "ManualOnly"
    },
    "Billing": {
      "Mode": "Disabled",
      "TestModeOnly": true,
      "FailedPaymentGracePeriodDays": 7,
      "Razorpay": {
        "KeyId": "",
        "KeySecret": "",
        "WebhookSecret": ""
      },
      "Plans": {
        "Pro": {
          "MonthlyRazorpayPlanId": "plan_test_pro_monthly",
          "AnnualRazorpayPlanId": "plan_test_pro_annual"
        },
        "Business": {
          "MonthlyRazorpayPlanId": "plan_test_business_monthly",
          "AnnualRazorpayPlanId": "plan_test_business_annual"
        }
      }
    }
  },
  "Plans": {
    "Free": {
      "Version": 1,
      "MaxMembers": 1,
      "MaxActiveWorkspaces": 3,
      "MaxSnapshotsPerMonth": 5,
      "MaxStorageBytes": 104857600,
      "MaxAiExtractionsPerMonth": 2,
      "MaxExternalReviewers": 1,
      "MaxExportDownloadsPerMonth": 10,
      "CanUseAiExtraction": false,
      "CanUseOcr": false,
      "CanTranscribeAudio": false,
      "CanUseChangeRequestWorkflow": true,
      "CanExportAdvancedPdf": false,
      "CanUseCustomLogo": false,
      "CanManageTeamMembers": false,
      "CanUseSharedTemplates": false,
      "CanConfigureRetention": false,
      "CanAccessApi": false
    },
    "Pro": {
      "Version": 1,
      "MaxMembers": 1,
      "MaxActiveWorkspaces": 25,
      "MaxSnapshotsPerMonth": 50,
      "MaxStorageBytes": 1073741824,
      "MaxAiExtractionsPerMonth": 100,
      "MaxExternalReviewers": 10,
      "MaxExportDownloadsPerMonth": 100,
      "CanUseAiExtraction": true,
      "CanUseOcr": true,
      "CanTranscribeAudio": true,
      "CanUseChangeRequestWorkflow": true,
      "CanExportAdvancedPdf": true,
      "CanUseCustomLogo": true,
      "CanManageTeamMembers": false,
      "CanUseSharedTemplates": true,
      "CanConfigureRetention": true,
      "CanAccessApi": false
    },
    "Business": {
      "Version": 1,
      "MaxMembers": 25,
      "MaxActiveWorkspaces": 100,
      "MaxSnapshotsPerMonth": 500,
      "MaxStorageBytes": 10737418240,
      "MaxAiExtractionsPerMonth": 1000,
      "MaxExternalReviewers": 50,
      "MaxExportDownloadsPerMonth": 1000,
      "CanUseAiExtraction": true,
      "CanUseOcr": true,
      "CanTranscribeAudio": true,
      "CanUseChangeRequestWorkflow": true,
      "CanExportAdvancedPdf": true,
      "CanUseCustomLogo": true,
      "CanManageTeamMembers": true,
      "CanUseSharedTemplates": true,
      "CanConfigureRetention": true,
      "CanAccessApi": true
    }
  },
  "AllowedHosts": "*"
}
